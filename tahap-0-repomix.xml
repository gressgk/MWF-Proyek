    protected $fillable = [
        'campaign_id',
        'judul',
        'isi',
        'foto_bukti',
        'dokumen_bukti',
        'nominal_terpakai',
    ];

    public function Campaign()
    {
        return $this->belongsTo(Campaign::class);
